@startuml classes_pdf-extractext
set namespaceSeparator none
skinparam classAttributeIconSize 0

package "app.domain" {
  class PDFDocument <<dataclass>> {
    + id : str | None
    + checksum : str
    + filename : str
    + text_content : str
    + content_type : str
    + page_count : int
    + file_size : int
    + created_at : datetime
    + updated_at : datetime
  }
  class ExtractedText <<NamedTuple>> {
    + text : str
    + page_count : int
  }
  abstract class PDFRepository <<port>> {
    + create(document) : PDFDocument
    + find_by_id(doc_id) : PDFDocument | None
    + find_by_checksum(checksum) : PDFDocument | None
    + find_all() : list[PDFDocument]
    + delete_by_id(doc_id) : bool
  }
  abstract class PDFTextExtractor <<port>> {
    + extract(file_content) : ExtractedText
  }
  class pdf_rules <<module>> {
    + validate_filename(filename)
    + validate_content(file_content)
    + validate_size(file_content, max_size)
    + generate_checksum(file_content) : str
  }
}

package "app.use_cases" {
  class UploadPDF {
    + execute(file_content, filename) : PDFDocument
  }
  class ListPDFs {
    + execute() : list[PDFDocument]
  }
  class GetPDF {
    + execute(doc_id) : PDFDocument
  }
  class DeletePDF {
    + execute(doc_id) : None
  }
}

package "app.infrastructure" {
  class MongoPDFRepository <<adapter>>
  class PypdfTextExtractor <<adapter>>
}

UploadPDF --> PDFRepository
UploadPDF --> PDFTextExtractor
UploadPDF ..> pdf_rules
ListPDFs --> PDFRepository
GetPDF --> PDFRepository
DeletePDF --> PDFRepository
PDFRepository ..> PDFDocument
PDFTextExtractor ..> ExtractedText

MongoPDFRepository ..|> PDFRepository
PypdfTextExtractor ..|> PDFTextExtractor

@enduml
