@startuml classes_pdf-extractext
set namespaceSeparator none
skinparam classAttributeIconSize 0

package "app.domain" {
  class PDFDocument <<entity>> {
    + id : str | None
    + checksum : str
    + filename : str
    + text_content : str
    + page_count : int
    + file_size : int
    + created_at : datetime
    + updated_at : datetime
    + {static} from_upload(file, text, page_count) : PDFDocument
  }
  class UploadedFile <<value object>> {
    + filename : str
    + content : bytes
    + size : int
    + checksum : str
    + ensure_not_larger_than(max_size)
  }
  class ExtractedText <<NamedTuple>> {
    + text : str
    + page_count : int
  }
  abstract class PDFReader <<port>> {
    + find_by_id(doc_id) : PDFDocument | None
    + find_all() : list[PDFDocument]
  }
  abstract class PDFWriter <<port>> {
    + create(document) : PDFDocument
    + delete_by_id(doc_id) : bool
  }
  abstract class PDFTextExtractor <<port>> {
    + extract(file_content) : ExtractedText
  }
}

package "app.use_cases" {
  class UploadPDF {
    + execute(file_content, filename) : PDFDocument
  }
  class ListPDFs {
    + execute() : list[PDFDocument]
  }
  class GetPDF {
    + execute(doc_id) : PDFDocument
  }
  class DeletePDF {
    + execute(doc_id) : None
  }
}

package "app.infrastructure" {
  class MongoPDFRepository <<adapter>>
  class PypdfTextExtractor <<adapter>>
}

UploadPDF --> PDFWriter
UploadPDF --> PDFTextExtractor
UploadPDF ..> UploadedFile
ListPDFs --> PDFReader
GetPDF --> PDFReader
DeletePDF --> PDFWriter
PDFDocument ..> UploadedFile
PDFReader ..> PDFDocument
PDFWriter ..> PDFDocument
PDFTextExtractor ..> ExtractedText

MongoPDFRepository ..|> PDFReader
MongoPDFRepository ..|> PDFWriter
PypdfTextExtractor ..|> PDFTextExtractor

@enduml
