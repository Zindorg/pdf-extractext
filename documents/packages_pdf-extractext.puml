@startuml packages_pdf-extractext
set namespaceSeparator none
skinparam packageStyle folder
left to right direction

package "Presentación" {
  package "app.routes" as routes
  package "app.schemas" as schemas
  package "app.api" as api
}
package "app.dependencies\n(composition root)" as deps
package "app.use_cases" as usecases
package "app.domain" as domain
package "app.infrastructure" as infra
package "app.config" as config

routes --> usecases : ejecuta
routes --> schemas : mapea a DTO
routes --> deps : Depends
schemas --> domain : from_document
api --> domain : errores -> HTTP (RFC 9457)

deps --> usecases : construye
deps --> infra : instancia adaptadores
deps --> config : lee settings

usecases --> domain : puertos + reglas

infra ..|> domain : implementa puertos

@enduml
